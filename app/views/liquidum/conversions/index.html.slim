= sts.form_for(@conversion, url: conversions_path, data: { turbo: false }) do |f|
  = sts.card(:liquidum_conversions, title: t('.title')) do |card|
    - card.with_action
      = f.submit t('.json_to_yaml'), name: "json_to_yaml"
      = f.submit t('.yaml_to_json'), name: "yaml_to_json"
      = f.submit t('.slim_to_html'), name: "slim_to_html"
    - card.with_tab :main, padding: true
        .grid.grid-cols-12.gap-4
          .col-span-12
            = f.editor :source, mode: "application/json"
          .col-span-12
            = f.editor :result, mode: "text/plain", read_only: true
