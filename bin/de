#!/usr/bin/env bash
# de: development environments for this repository. Run without arguments
# for help. Repository specific settings live in .devcontainer/env.conf, this
# script is generic: it comes from the de repository, whose `de init` copies
# it into a repository as bin/de, the same everywhere. Run from the de
# repository itself (e.g. linked onto the PATH as `de`), it sets repositories
# up and hands every other command to the bin/de of the current checkout.
#
# Every checkout (main checkout or git worktree) gets its own environment: a
# Docker Compose project named after the branch, labelled with
#
#   dev.env.name    the environment (and compose project) name
#   dev.env.kind    persistent | ephemeral
#   dev.env.branch  the branch, empty for a detached HEAD
#   dev.env.path    the checkout on the host
#   dev.env.gitdir  the repository's common .git directory on the host
#
# Cleanup selects resources by these labels, never by name.
set -euo pipefail

# Through symlinks, e.g. ~/.local/bin/de to the de repository's bin/de
DE_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
# Set when running from the de repository rather than a repository's copy
DE_TEMPLATE=""
DE_DOCS="https://github.com/tdegrunt/de#readme"
# Your own tools for every environment, see env_write_host_feature
DE_CONFIG="${DE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/de/config.json}"
# Where the folders "home" in DE_CONFIG lists are kept, shared by every environment
DE_HOME_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/de/home"
# `de exec` passes a SELENIUM_URL from the caller on, see env.conf. Unset it
# so env.conf's value isn't exported to the commands this script runs.
ENV_SELENIUM_URL_GIVEN="${SELENIUM_URL:-}"
unset SELENIUM_URL
UP_COMMAND=()
PRIMARY_BRANCHES=(main master)
if [ -f "$DE_ROOT/.devcontainer/env.conf" ]; then
  # shellcheck source=../.devcontainer/env.conf
  source "$DE_ROOT/.devcontainer/env.conf"
elif [ -d "$DE_ROOT/template" ]; then
  DE_TEMPLATE="$DE_ROOT/template"
else
  printf 'error: %s has neither .devcontainer/env.conf nor template/\n' "$DE_ROOT" >&2
  exit 1
fi

# The commands of a repository's bin/de, also listed by the de repository's help
usage_commands() {
  cat <<'EOF'
  new <branch> [folder] [--from <ref>] [--copy-data[=<services>]]
      [--copy-data-from <checkout>] [--yes] [--no-trust]
                     Create a worktree for a branch (next to the main checkout
                     as <repository>-<branch> unless a folder is given) and
                     start its environment. New branches start from the
                     default branch, or from --from. --no-trust as for up.
                     --copy-data starts it with a copy of the volumes of the
                     environment it branches off (an existing branch: this
                     checkout's, or --copy-data-from's), of every service but
                     app or the listed ones, e.g. --copy-data=postgres,redis.
                     Those services are stopped during the copy, after
                     confirming, or right away with --yes.
  up [--rebuild] [--no-trust]
                     Create or start this checkout's environment and prepare
                     its databases. --rebuild recreates the containers after
                     changing .devcontainer/, keeping the data. Trusts the
                     checkout's mise config on the host, unless --no-trust.
  exec <command...>  Run a command in this checkout's devcontainer, in the same
                     directory relative to the checkout.
  status             Show the environment's containers, health and URLs.
  code [<checkout>]  Open a checkout in VS Code inside its devcontainer,
                     starting it first if needed. <checkout> is a branch,
                     environment name, worktree folder name or a path in
                     it, default this one.
  down [--destroy-persistent]
                     Remove an ephemeral environment with its data. A
                     persistent one is only stopped, unless
                     --destroy-persistent is given and its name confirmed.
  prune [--yes]      Remove ephemeral environments whose worktree or branch
                     is gone. --yes skips the confirmation.
EOF
}

usage() {
  cat <<EOF
Usage: bin/de <command> [arguments]

Every checkout of this repository, the main one and each git worktree, gets
its own development environment: a devcontainer with its own services,
volumes and network. Environments for ${PRIMARY_BRANCHES[*]} ${PERSISTENT_BRANCHES[*]} are
persistent and keep their data, all others are ephemeral. A primary branch
(${PRIMARY_BRANCHES[*]}) gets one named $ENV_REPO, the others $ENV_REPO-<branch>.

Commands:
$(usage_commands)
  help               Show this help.

Examples:
  bin/de new fix-login
  bin/de exec bin/rails test
  SELENIUM_URL=http://host.docker.internal:4444/ HEADLESS=0 bin/de exec bin/rails test:system
  bin/de code main

Settings: .devcontainer/env.conf, your own tools: $DE_CONFIG,
docs: $DE_DOCS. To update bin/de, run \`de update\` from the de repository.
EOF
}

# Help when running from the de repository
usage_source() {
  cat <<EOF
Usage: de <command> [arguments]

Development environments, one devcontainer per checkout. This is the de
repository's copy ($DE_ROOT): it sets repositories up, and hands every other
command to the bin/de of the checkout you're in.

Commands:
  init [<repository>] [--name <name>] [--force]
                     Set up development environments in a repository (default
                     the current one). Repository specific files that already
                     exist there are kept, unless --force is given. --name
                     sets ENV_REPO, the prefix of its environment names,
                     default the repository's folder name: needed when two
                     repositories have folders of the same name.
  update [<repository>] [--name <name>] [--force]
                     Update a repository's bin/de, and add what's new in the
                     setup, like init but only where it's set up already.
  upgrade            Update this copy of de with a git pull. Then run de
                     update in a repository to update its bin/de.
  help               Show this help.

Run by the current checkout's bin/de (see bin/de help there):
$(usage_commands)

Your own tools for every environment: $DE_CONFIG
EOF
}

# --- Output -------------------------------------------------------------

log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# Prints a command, then runs it
run() {
  printf '\033[2m+' >&2
  printf ' %q' "$@" >&2
  printf '\033[0m\n' >&2
  "$@"
}

devcontainer_cli() {
  if command -v devcontainer >/dev/null 2>&1; then
    run devcontainer "$@"
  else
    run npx --yes "@devcontainers/cli@$DEVCONTAINER_CLI_VERSION" "$@"
  fi
}

# --- Environment identity -----------------------------------------------

# Lowercases and replaces everything but [a-z0-9-] with dashes
env_sanitize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | tr -s '-' | sed 's/^-//; s/-$//'
}

env_is_primary_branch() {
  local branch
  for branch in "${PRIMARY_BRANCHES[@]}"; do
    [ "$1" = "$branch" ] && return 0
  done
  return 1
}

# Primary branches are always persistent
env_is_persistent_branch() {
  local branch
  env_is_primary_branch "$1" && return 0
  for branch in "${PERSISTENT_BRANCHES[@]}"; do
    [ "$1" = "$branch" ] && return 0
  done
  return 1
}

# Prints the environment name for a checkout directory
env_name_for() {
  local dir="$1" branch name
  branch="$(git -C "$dir" symbolic-ref --short -q HEAD || true)"
  if [ -n "$branch" ]; then
    env_name_for_branch "$branch"
    return
  fi
  env_name_shorten "$(env_sanitize "$ENV_REPO-detached-$(basename "$dir")")"
}

# Prints the environment name for a checkout of a branch
env_name_for_branch() {
  if env_is_primary_branch "$1"; then
    env_name_shorten "$(env_sanitize "$ENV_REPO")"
  else
    env_name_shorten "$(env_sanitize "$ENV_REPO-$1")"
  fi
}

# Compose project names and OrbStack domain labels max out at 63 characters
env_name_shorten() {
  local name="$1"
  if [ "${#name}" -gt 63 ]; then
    name="${name:0:54}-$(printf '%s' "$name" | shasum | cut -c1-8)"
  fi
  printf '%s' "$name"
}

# Sets the ENV_* variables describing the checkout that contains $1
env_init() {
  local dir="${1:-$PWD}" common

  ENV_PATH="$(cd "$(git -C "$dir" rev-parse --show-toplevel)" && pwd -P)" ||
    die "$dir is not inside a git checkout"
  common="$(git -C "$ENV_PATH" rev-parse --git-common-dir)"
  ENV_GIT_COMMON_DIR="$(cd "$ENV_PATH" && cd "$common" && pwd -P)"
  ENV_MAIN_CHECKOUT="$(dirname "$ENV_GIT_COMMON_DIR")"
  ENV_BRANCH="$(git -C "$ENV_PATH" symbolic-ref --short -q HEAD || true)"
  ENV_NAME="$(env_name_for "$ENV_PATH")"

  if [ -n "$ENV_BRANCH" ] && env_is_persistent_branch "$ENV_BRANCH"; then
    ENV_KIND=persistent
    ENV_RESTART=unless-stopped
  else
    ENV_KIND=ephemeral
    ENV_RESTART=no
  fi

  # Inside the container, both the checkout and the common .git directory are
  # mounted at /workspaces/<host path>, so the relative paths in a worktree's
  # .git file (worktree.useRelativePaths) resolve the same way.
  # devcontainer.json uses the same path as its workspaceFolder.
  ENV_PATH_IN_CONTAINER="/workspaces$ENV_PATH"
  ENV_GIT_COMMON_DIR_IN_CONTAINER="/workspaces$ENV_GIT_COMMON_DIR"
  # A shorter, stable path to the checkout, for interactive use
  ENV_WORKSPACE_LINK="/workspaces/$ENV_REPO"

  ENV_DOTENV="$ENV_PATH/.devcontainer/.env"
}

# Prints where a browser driven through Selenium at $1 reaches the app's test
# server: by service name from the environment's own selenium container, and
# by OrbStack domain from a browser on the Mac
env_capybara_app_host() {
  case "$1" in
    *//selenium:*) echo "http://app:3100" ;;
    *) echo "http://app.$ENV_NAME.orb.local:3100" ;;
  esac
}

# Writes .devcontainer/.env, which docker compose reads for the project name,
# labels and mounts
env_write_dotenv() {
  cat > "$ENV_DOTENV" <<EOF
# Written by bin/de, don't edit
COMPOSE_PROJECT_NAME=$ENV_NAME
ENV_NAME=$ENV_NAME
ENV_KIND=$ENV_KIND
ENV_BRANCH=$ENV_BRANCH
ENV_PATH=$ENV_PATH
ENV_GIT_COMMON_DIR=$ENV_GIT_COMMON_DIR
ENV_PATH_IN_CONTAINER=$ENV_PATH_IN_CONTAINER
ENV_GIT_COMMON_DIR_IN_CONTAINER=$ENV_GIT_COMMON_DIR_IN_CONTAINER
ENV_WORKSPACE_LINK=$ENV_WORKSPACE_LINK
ENV_RESTART=$ENV_RESTART
ENV_GIT_CONFIG_DIR=$HOME/.config/git
SELENIUM_URL=$SELENIUM_URL
CAPYBARA_APP_HOST=$(env_capybara_app_host "$SELENIUM_URL")
EOF
}

# --- Docker resources ---------------------------------------------------

# Runs docker compose for this checkout's project
env_compose() {
  run docker compose --project-directory "$ENV_PATH/.devcontainer" \
    -f "$ENV_PATH/.devcontainer/docker-compose.yml" \
    --env-file "$ENV_DOTENV" -p "$ENV_NAME" "$@"
}

# Succeeds when the app container of an environment is running
env_running() {
  [ -n "$(docker container ls -q --filter "label=dev.env.name=$1" --filter label=com.docker.compose.service=app)" ]
}

# Prints the value of a label on any container, volume or network of an
# environment
env_label() {
  local name="$1" label="$2" kind values
  for kind in container volume network; do
    values="$(docker "$kind" ls $([ "$kind" = container ] && echo -a) --filter "label=dev.env.name=$name" --format "{{.Label \"$label\"}}")"
    if [ -n "$values" ]; then
      head -n1 <<<"$values"
      return
    fi
  done
}

# Prints the names of this repository's environments of a kind, one per line
env_list() {
  local kind_filter="label=dev.env.kind=$1" repo_filter="label=dev.env.gitdir=$ENV_GIT_COMMON_DIR"
  {
    docker container ls -a --filter "$kind_filter" --filter "$repo_filter" --format '{{.Label "dev.env.name"}}'
    docker volume ls --filter "$kind_filter" --filter "$repo_filter" --format '{{.Label "dev.env.name"}}'
    docker network ls --filter "$kind_filter" --filter "$repo_filter" --format '{{.Label "dev.env.name"}}'
  } | sort -u | sed '/^$/d'
}

# Succeeds when any resource of the environment is labelled persistent
env_is_persistent() {
  [ -n "$(docker container ls -aq --filter "label=dev.env.name=$1" --filter label=dev.env.kind=persistent)$(docker volume ls -q --filter "label=dev.env.name=$1" --filter label=dev.env.kind=persistent)$(docker network ls -q --filter "label=dev.env.name=$1" --filter label=dev.env.kind=persistent)" ]
}

# Removes every container, volume and network of an environment. Resources are
# found by the dev.env.name label, plus the compose project label for the ones
# devcontainer features add without our labels (the docker-in-docker volume).
env_destroy() {
  local name="$1" ids filter
  for filter in "label=dev.env.name=$name" "label=com.docker.compose.project=$name"; do
    ids="$(docker container ls -aq --filter "$filter")"
    [ -z "$ids" ] || run docker container rm --force --volumes $ids >/dev/null
  done
  for filter in "label=dev.env.name=$name" "label=com.docker.compose.project=$name"; do
    ids="$(docker volume ls -q --filter "$filter")"
    [ -z "$ids" ] || run docker volume rm --force $ids >/dev/null
    ids="$(docker network ls -q --filter "$filter")"
    [ -z "$ids" ] || run docker network rm $ids >/dev/null
  done
}

# Prints "<service> <health>" for every running container of an environment,
# where health is the healthcheck status, or "running" without a healthcheck
env_health() {
  local ids
  ids="$(docker container ls -q --filter "label=dev.env.name=$1")"
  [ -z "$ids" ] && return
  # shellcheck disable=SC2086
  docker container inspect $ids --format '{{ index .Config.Labels "com.docker.compose.service" }} {{ if .State.Health }}{{ .State.Health.Status }}{{ else }}{{ .State.Status }}{{ end }}'
}

# Prints "<path>\t<branch>" for every checkout of the repository
checkouts() {
  git -C "$ENV_PATH" worktree list --porcelain | awk '
    /^worktree / { if (path != "") print path "\t" branch; path = substr($0, 10); branch = "" }
    /^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
    END          { if (path != "") print path "\t" branch }'
}

# Prints the checkout a branch, environment name, worktree folder name or a
# path in it names, nothing when none does
checkout_for() {
  local path branch
  while IFS=$'\t' read -r path branch; do
    [ -d "$path" ] || continue
    if [ "$1" = "$branch" ] || [ "$1" = "$(basename "$path")" ] || [ "$1" = "$(env_name_for "$path")" ]; then
      printf '%s' "$path"
      return
    fi
  done < <(checkouts)
  # Or any folder in a checkout, e.g. the absolute path Orca's "Open in" adds
  if [ -d "$1" ]; then
    (cd "$(git -C "$1" rev-parse --show-toplevel)" && pwd -P) || die "$1 is not inside a git checkout"
  fi
}

# Lists the checkouts with their environment names, on stderr
checkouts_print() {
  local path branch
  while IFS=$'\t' read -r path branch; do
    [ -d "$path" ] && printf '  %-40s %-30s %s\n' "$(env_name_for "$path")" "${branch:-(detached)}" "$path" >&2
  done < <(checkouts)
}

# --- Copying data -------------------------------------------------------

# Succeeds when service $1 is one of the comma separated services in $2, or
# with "all", when it's any service but the devcontainer itself (app, whose
# docker-in-docker volume is a cache)
copy_data_wants() {
  if [ "$2" = all ]; then
    [ "$1" != app ]
  else
    [[ ",$2," == *",$1,"* ]]
  fi
}

# Finds the named volumes of environment $1 to copy, those of the services $2
# wants (see copy_data_wants). Sets COPY_VOLUMES ("<volume> <compose volume
# key> <image>"), and COPY_RUNNING and COPY_RUNNING_SERVICES: the running
# containers mounting them and their services.
copy_data_find() {
  local src="$1" wanted="$2" id service image volume key available="" chosen="" found
  COPY_VOLUMES=() COPY_RUNNING="" COPY_RUNNING_SERVICES=""
  for id in $(docker container ls -aq --filter "label=com.docker.compose.project=$src"); do
    service="$(docker container inspect "$id" --format '{{ index .Config.Labels "com.docker.compose.service" }}')"
    image="$(docker container inspect "$id" --format '{{ .Config.Image }}')"
    found=false
    # Named volumes of this environment only, not anonymous or shared ones
    for volume in $(docker container inspect "$id" --format '{{ range .Mounts }}{{ if eq .Type "volume" }}{{ println .Name }}{{ end }}{{ end }}'); do
      [ "$(docker volume inspect "$volume" --format '{{ index .Labels "com.docker.compose.project" }}')" = "$src" ] || continue
      key="$(docker volume inspect "$volume" --format '{{ index .Labels "com.docker.compose.volume" }}')"
      [ -n "$key" ] || continue
      found=true
      copy_data_wants "$service" "$wanted" || continue
      [ "$volume" = "${src}_$key" ] || die "volume $volume of $service has a fixed name, it can't be copied"
      COPY_VOLUMES+=("$volume $key $image")
    done
    $found || continue
    available="$available $service"
    copy_data_wants "$service" "$wanted" || continue
    chosen="$chosen $service "
    if [ "$(docker container inspect "$id" --format '{{ .State.Running }}')" = true ]; then
      COPY_RUNNING="$COPY_RUNNING $id"
      COPY_RUNNING_SERVICES="$COPY_RUNNING_SERVICES $service"
    fi
  done

  if [ "$wanted" != all ]; then
    for service in ${wanted//,/ }; do
      [[ "$chosen" == *" $service "* ]] ||
        die "$src has no service $service with a named volume, these have one:${available:- none}"
    done
  fi
  [ "${#COPY_VOLUMES[@]}" -gt 0 ] || die "$src has no data to copy, its services with a named volume:${available:- none}"
}

# Copies the COPY_VOLUMES of environment $1 into new volumes for the
# environment of branch $2 in checkout $3, labelled as compose creates them,
# so bin/de up adopts them and bin/de down removes them. The services using
# them are stopped meanwhile, so e.g. postgres's files are consistent, and
# started again afterwards, also when the copy fails.
copy_data() {
  local src="$1" branch="$2" path="$3" target kind=ephemeral entry volume key image
  target="$(env_name_for_branch "$branch")"
  env_is_persistent_branch "$branch" && kind=persistent

  if [ -n "$COPY_RUNNING" ]; then
    log "Stopping$COPY_RUNNING_SERVICES of $src for the copy"
    # shellcheck disable=SC2086
    run docker container stop $COPY_RUNNING >/dev/null
    # shellcheck disable=SC2064
    trap "log 'Starting$COPY_RUNNING_SERVICES of $src again'; run docker container start $COPY_RUNNING >/dev/null" EXIT
  fi

  for entry in "${COPY_VOLUMES[@]}"; do
    read -r volume key image <<<"$entry"
    log "Copying $volume to ${target}_$key"
    run docker volume create \
      --label "dev.env.name=$target" --label "dev.env.kind=$kind" --label "dev.env.branch=$branch" \
      --label "dev.env.path=$path" --label "dev.env.gitdir=$ENV_GIT_COMMON_DIR" \
      --label "com.docker.compose.project=$target" --label "com.docker.compose.volume=$key" \
      "${target}_$key" >/dev/null
    run docker run --rm --user 0:0 --entrypoint "" \
      -v "$volume:/from:ro" -v "${target}_$key:/to" "$image" cp -a /from/. /to/
    grep -qE "^  $key:" "$path/.devcontainer/docker-compose.yml" ||
      warn "$branch's docker-compose.yml has no volume $key, the copy isn't used"
  done

  if [ -n "$COPY_RUNNING" ]; then
    trap - EXIT
    log "Starting$COPY_RUNNING_SERVICES of $src again"
    # shellcheck disable=SC2086
    run docker container start $COPY_RUNNING >/dev/null
  fi
}

# --- Commands -----------------------------------------------------------

# Writes the local feature devcontainer.json includes as ./de-host, from
# $DE_CONFIG on the host: your own editor extensions, npm packages and
# features for every environment of every repository, e.g.
#
#   {
#     "extensions": ["anthropic.claude-code", "openai.chatgpt"],
#     "npm": ["@anthropic-ai/claude-code", "@openai/codex"],
#     "features": { "ghcr.io/devcontainers/features/python:1": {} },
#     "home": [".claude", ".codex"],
#     "env": { "CLAUDE_CONFIG_DIR": "/home/vscode/.claude" }
#   }
#
# "home" lists folders in the container's home directory that every
# environment shares, kept on the host in $DE_HOME_STATE, e.g. logins. "env"
# sets environment variables in the container.
#
# A feature, so the editor installs its extensions in the container whoever
# opens it, and its packages are part of the image. Changes apply on the next
# build, bin/de up --rebuild.
env_write_host_feature() {
  local dir="$ENV_PATH/.devcontainer/de-host" config='{}' path
  if [ -f "$DE_CONFIG" ]; then
    command -v jq >/dev/null 2>&1 || die "reading $DE_CONFIG needs jq"
    config="$(jq -e 'if type == "object" then . else error("not an object") end' "$DE_CONFIG")" ||
      die "$DE_CONFIG isn't a JSON object"
  fi
  # Docker refuses a missing bind source
  while IFS= read -r path; do
    case "$path" in "" | /* | *..*) die "home in $DE_CONFIG takes paths inside the home directory, not $path" ;; esac
    mkdir -p "$DE_HOME_STATE/$path"
  done < <([ "$config" = '{}' ] || jq -r '.home // [] | .[]' <<<"$config")
  mkdir -p "$dir"
  if [ "$config" = '{}' ]; then
    printf '{ "id": "de-host", "version": "1.0.0", "name": "Nothing from %s" }\n' "$DE_CONFIG" > "$dir/devcontainer-feature.json"
    printf '#!/bin/sh\n# Written by bin/de, %s has nothing to install\n' "$DE_CONFIG" > "$dir/install.sh"
  else
    jq --arg config "$DE_CONFIG" --arg state "$DE_HOME_STATE" '{
        id: "de-host",
        version: "1.0.0",
        name: "Your own tools from \($config), written by bin/de",
        installsAfter: ["ghcr.io/devcontainers/features/node"],
        customizations: { vscode: { extensions: (.extensions // []) } }
      }
      + (if (.features // {}) != {} then { dependsOn: .features } else {} end)
      + (if (.home // []) != [] then { mounts: [.home[] | { type: "bind", source: "\($state)/\(.)", target: "/home/vscode/\(.)" }] } else {} end)
      + (if (.env // {}) != {} then { containerEnv: .env } else {} end)' <<<"$config" > "$dir/devcontainer-feature.json"
    {
      printf '#!/bin/sh\n# Written by bin/de from %s, do not edit\nset -e\n' "$DE_CONFIG"
      jq -r '.npm // [] | if length > 0 then "npm install --global --no-fund --no-audit " + (map(@sh) | join(" ")) else empty end' <<<"$config"
    } > "$dir/install.sh"
  fi
  chmod +x "$dir/install.sh"
}

# Runs on the host before the containers start, see initializeCommand in
# devcontainer.json, so opening a checkout from an editor works too
# The Mac's mise refuses a checkout's config until it's trusted, also for
# commands this script runs there, like npx. Trust is per path, so every
# worktree needs it, the container trusts its own copy in postStart.sh.
env_trust_mise() {
  local file
  command -v mise >/dev/null 2>&1 || return 0
  for file in mise.toml mise.local.toml .mise.toml .mise.local.toml; do
    [ -f "$ENV_PATH/$file" ] || continue
    log "Trusting $file on the host (--no-trust to skip)"
    run mise trust --quiet "$ENV_PATH/$file"
  done
}

cmd_initialize() {
  # docker-compose.yml mounts it, and Docker refuses a missing bind source
  mkdir -p "$HOME/.config/git"
  env_write_dotenv
  env_write_host_feature
  log "Environment $ENV_NAME ($ENV_KIND)"
}

# Copies the setup into a repository, from the de repository. bin/de is
# generic and always updated; the template is repository
# specific, a starting point that is only copied when missing, or with --force.
# As de update, the same for a repository that's set up already.
# The repository's name (ENV_REPO, @REPO@ in the template) is --name, else
# the ENV_REPO it already has, else its main checkout's folder name.
cmd_init() {
  local target="" force=false name="" rel src common repo current up_command entry
  local usage_line="usage: de $command [<repository>] [--name <name>] [--force]"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=true; shift ;;
      --name) [ "$#" -ge 2 ] || die "$usage_line"; name="$2"; shift 2 ;;
      --name=*) name="${1#--name=}"; shift ;;
      -*) die "$usage_line" ;;
      *) [ -z "$target" ] || die "$usage_line"; target="$1"; shift ;;
    esac
  done
  if [ -n "$name" ] && [ "$(env_sanitize "$name")" != "$name" ]; then
    die "--name $name: use lowercase letters, digits and dashes, e.g. $(env_sanitize "$name")"
  fi
  target="${target:-$PWD}"
  [ -d "$target" ] || die "$target doesn't exist"
  target="$(cd "$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" && pwd -P)" ||
    die "$target isn't a git checkout"
  [ "$target" != "$DE_ROOT" ] || die "$target is the de repository itself"
  if [ "$command" = update ] && [ ! -f "$target/.devcontainer/env.conf" ]; then
    die "$target isn't set up yet, run: de init"
  fi

  # In a subshell, env.conf is shell and sets more than ENV_REPO
  current=""
  if [ -f "$target/.devcontainer/env.conf" ]; then
    current="$(ENV_REPO="" && source "$target/.devcontainer/env.conf" && printf '%s' "$ENV_REPO")"
  fi
  # Renaming would leave environments behind under the old name
  if [ -n "$name" ] && [ -n "$current" ] && [ "$name" != "$current" ]; then
    $force || die "$target is named $current already. To rename it, run bin/de down in each of its checkouts, then set ENV_REPO=$name in .devcontainer/env.conf (and \"name\" in devcontainer.json)"
    warn "renaming $current to $name, environments created as $current are left as they are"
  fi
  if [ -n "$name" ]; then
    repo="$name"
  elif [ -n "$current" ]; then
    repo="$current"
  else
    common="$(cd "$target" && cd "$(git rev-parse --git-common-dir)" && pwd -P)"
    repo="$(env_sanitize "$(basename "$(dirname "$common")")")"
  fi
  if [ -d "$target/test/dummy" ] && [ -x "$target/bin/rails" ]; then
    up_command="env RAILS_ENV=test bin/rails app:db:prepare"
  elif [ -x "$target/bin/rails" ]; then
    up_command="env RAILS_ENV=test bin/rails db:prepare"
  else
    up_command=""
  fi
  if [ "$command" = update ]; then
    log "Updating development environments in $target ($repo)"
  else
    log "Setting up development environments in $target ($repo)"
  fi

  # Generic: always the same as in the de repository
  if cmp -s "$DE_ROOT/bin/de" "$target/bin/de"; then
    printf '  %-36s up to date\n' bin/de >&2
  else
    run mkdir -p "$target/bin"
    run cp -p "$DE_ROOT/bin/de" "$target/bin/de"
  fi
  # The docs used to be copied too, they live in the de repository now
  if [ -f "$target/.devcontainer/README.md" ] && grep -q '^`bin/de` manages them' "$target/.devcontainer/README.md"; then
    log "Removing .devcontainer/README.md, the docs are at $DE_DOCS"
    run rm "$target/.devcontainer/README.md"
  fi

  # Repository specific: services, image, setup steps and settings
  while IFS= read -r rel; do
    rel="${rel#./}"
    if [ -e "$target/$rel" ] && ! $force; then
      printf '  %-36s exists, kept (--force to replace)\n' "$rel" >&2
      continue
    fi
    run mkdir -p "$(dirname "$target/$rel")"
    run cp -p "$DE_TEMPLATE/$rel" "$target/$rel"
    sed -i '' -e "s|@REPO@|$repo|g" -e "s|@UP_COMMAND@|$up_command|g" "$target/$rel"
  done < <(cd "$DE_TEMPLATE" && find . -type f | sort)

  if ! grep -q '"\./de-host"' "$target/.devcontainer/devcontainer.json"; then
    warn "add \"./de-host\": {} to the features in .devcontainer/devcontainer.json, for your own tools from $DE_CONFIG"
  fi

  # Never commit generated files or local secrets
  for entry in .devcontainer/.env .devcontainer/de-host/ mise.local.toml; do
    # A file inside, as a directory entry like de-host/ only matches what's in it
    git -C "$target" check-ignore -q --no-index -- "${entry%/}$([ "${entry%/}" = "$entry" ] || echo /x)" && continue
    log "Adding $entry to .gitignore"
    # Not onto the last line when the file doesn't end in a newline
    if [ -s "$target/.gitignore" ] && [ -n "$(tail -c1 "$target/.gitignore")" ]; then
      echo >> "$target/.gitignore"
    fi
    printf '%s\n' "$entry" >> "$target/.gitignore"
  done

  if [ "$command" = update ]; then
    log "Done, review the changes in $target and commit them"
    return
  fi

  cat <<EOF

Done. Review the repository specific files for $repo, then start it:

  .devcontainer/env.conf            ENV_REPO, PERSISTENT_BRANCHES, UP_COMMAND
  .devcontainer/docker-compose.yml  services, keep the x-env-labels and mounts
  .devcontainer/postStart.sh        installing dependencies, the dev database
  .devcontainer/devcontainer.json   features, keep ./de-host and the mounts
  .worktreeinclude                  ignored files new worktrees need
  orca.yaml                         Orca's worktree hooks

  cd $target && bin/de up

Run de update there later to update its bin/de.
EOF
}

# Pulls the de repository, as install.sh does when it's already installed.
# Repositories keep their bin/de until de update runs there.
cmd_upgrade() {
  local before after
  [ "$#" -eq 0 ] || die "usage: de upgrade"
  git -C "$DE_ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "$DE_ROOT isn't a git checkout"
  before="$(git -C "$DE_ROOT" rev-parse HEAD)"
  log "Updating $DE_ROOT"
  git -C "$DE_ROOT" pull --ff-only --quiet || die "couldn't update $DE_ROOT"
  after="$(git -C "$DE_ROOT" rev-parse HEAD)"
  if [ "$before" = "$after" ]; then
    log "Already up to date"
    return
  fi
  git -C "$DE_ROOT" log --oneline --no-decorate "$before..$after" >&2
  log "Updated, run de update in a repository to update its bin/de"
}

cmd_new() {
  local branch="" folder="" from="" file dest up_args=() existing=false
  local copy="" copy_from="" yes=false source="" source_name="" target_name path checkout_branch answer
  local usage_line="usage: bin/de new <branch> [folder] [--from <ref>] [--copy-data[=<services>]] [--copy-data-from <checkout>] [--yes] [--no-trust]"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) [ "$#" -ge 2 ] || die "$usage_line"; from="$2"; shift 2 ;;
      --copy-data) copy=all; shift ;;
      --copy-data=*) copy="${1#--copy-data=}"; [ -n "$copy" ] || die "$usage_line"; shift ;;
      --copy-data-from) [ "$#" -ge 2 ] || die "$usage_line"; copy_from="$2"; shift 2 ;;
      --copy-data-from=*) copy_from="${1#--copy-data-from=}"; shift ;;
      --yes | -y) yes=true; shift ;;
      --no-trust) up_args+=(--no-trust); shift ;;
      -*) die "$usage_line" ;;
      *)
        if [ -z "$branch" ]; then branch="$1"
        elif [ -z "$folder" ]; then folder="$1"
        else die "$usage_line"
        fi
        shift
        ;;
    esac
  done
  [ -n "$branch" ] || die "$usage_line"
  git check-ref-format --branch "$branch" >/dev/null || die "$branch isn't a valid branch name"
  [ -n "$copy_from" ] && [ -z "$copy" ] && copy=all

  [ -n "$folder" ] || folder="$(dirname "$ENV_MAIN_CHECKOUT")/$(env_sanitize "$ENV_REPO-$branch")"
  [ -e "$folder" ] && die "$folder already exists"

  if git -C "$ENV_PATH" show-ref --verify --quiet "refs/heads/$branch" ||
    [ -n "$(git -C "$ENV_PATH" for-each-ref --format='%(refname)' "refs/remotes/*/$branch")" ]; then
    existing=true
  elif [ -z "$from" ]; then
    from="$(git -C "$ENV_PATH" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo HEAD)"
    # Prefer the local branch when there is one, e.g. main over origin/main
    git -C "$ENV_PATH" show-ref --verify --quiet "refs/heads/${from#origin/}" && from="${from#origin/}"
  fi

  # Everything about the copy is checked before the worktree is created.
  # The data comes from the checkout of the branch the new one starts from,
  # or for an existing branch, from this checkout.
  if [ -n "$copy" ]; then
    if [ -n "$copy_from" ]; then
      source="$(checkout_for "$copy_from")"
      if [ -z "$source" ]; then
        warn "no checkout of $ENV_REPO matches $copy_from, these exist:"
        checkouts_print
        die "nothing created"
      fi
    elif $existing || [ "$from" = HEAD ]; then
      source="$ENV_PATH"
    else
      while IFS=$'\t' read -r path checkout_branch; do
        if [ -d "$path" ] && [ -n "$checkout_branch" ] &&
          { [ "$from" = "$checkout_branch" ] || [ "$from" = "origin/$checkout_branch" ]; }; then
          source="$path"
          break
        fi
      done < <(checkouts)
      [ -n "$source" ] || die "$from isn't checked out, so it has no environment to copy data from. Pick one with --copy-data-from <checkout>"
    fi
    source_name="$(env_name_for "$source")"
    target_name="$(env_name_for_branch "$branch")"
    [ "$source_name" != "$target_name" ] || die "$branch's environment is $source_name itself, nothing to copy"
    [ -n "$(docker container ls -aq --filter "label=com.docker.compose.project=$source_name")" ] ||
      die "$source_name has no environment to copy data from, start it with bin/de up in $source"
    [ -z "$(docker volume ls -q --filter "label=com.docker.compose.project=$target_name")" ] ||
      die "$target_name has volumes already, remove them first, e.g. with bin/de prune"
    copy_data_find "$source_name" "$copy"

    log "Copying data from $source_name ($source) to $target_name:"
    printf '  %s\n' "${COPY_VOLUMES[@]%% *}" >&2
    if [ -n "$COPY_RUNNING" ] && ! $yes; then
      [ -t 0 ] || die "pass --yes to stop$COPY_RUNNING_SERVICES of $source_name for the copy without a terminal"
      read -r -p "This stops$COPY_RUNNING_SERVICES of $source_name during the copy, then starts them again. Continue? [y/N] " answer
      [ "$answer" = y ] || [ "$answer" = Y ] || die "nothing created"
    fi
  fi

  log "Creating worktree $folder for $branch"
  if $existing; then
    # Creates a local branch tracking the remote one, when there's only that
    run git -C "$ENV_PATH" worktree add "$folder" "$branch"
  else
    run git -C "$ENV_PATH" worktree add -b "$branch" "$folder" "$from"
  fi
  folder="$(cd "$folder" && pwd -P)"

  # Branches that predate the environment setup get it from this checkout,
  # with mise.toml: its SELENIUM_URL would override the environment's
  if [ ! -x "$folder/bin/de" ]; then
    warn "$branch has no environment setup, copying it from $ENV_PATH (uncommitted there)"
    for file in "$ENV_PATH"/.devcontainer/* "$ENV_PATH/bin/de" "$ENV_PATH/mise.toml"; do
      [ -e "$file" ] || continue
      dest="$folder/${file#"$ENV_PATH"/}"
      run mkdir -p "$(dirname "$dest")"
      run cp -p "$file" "$dest"
    done
  fi

  # A branch's older bin/de may not know --no-trust
  if [ "${#up_args[@]}" -gt 0 ] && ! grep -q -- '--no-trust' "$folder/bin/de"; then
    warn "$branch's bin/de doesn't support --no-trust, it won't trust mise config anyway"
    up_args=()
  fi
  [ -z "$copy" ] || copy_data "$source_name" "$branch" "$folder"
  run "$folder/bin/de" up ${up_args[@]+"${up_args[@]}"}

  cat <<EOF

Worktree $folder is ready:

  cd $folder
  bin/de exec bin/rails test
  bin/de code               # open in VS Code
  bin/de down               # when done, then: git worktree remove $folder
EOF
}

cmd_up() {
  local up_args=() trust=true arg other entry health deadline
  for arg in "$@"; do
    case "$arg" in
      --rebuild) up_args=(--remove-existing-container) ;;
      --no-trust) trust=false ;;
      *) die "usage: bin/de up [--rebuild] [--no-trust]" ;;
    esac
  done

  log "Environment $ENV_NAME ($ENV_KIND, branch ${ENV_BRANCH:-detached}) for $ENV_PATH"

  # Share nothing: refuse to adopt another checkout's resources
  other="$(env_label "$ENV_NAME" dev.env.path)"
  if [ -n "$other" ] && [ "$other" != "$ENV_PATH" ]; then
    die "$ENV_NAME already belongs to $other, remove that environment first"
  fi

  # Worktree .git files point to the main repository by relative path, so the
  # link also resolves inside the container
  if [ "$(git -C "$ENV_PATH" config --get worktree.useRelativePaths || true)" != true ]; then
    log "Enabling relative worktree paths"
    run git -C "$ENV_PATH" config worktree.useRelativePaths true
  fi
  if [ "$ENV_PATH" != "$ENV_MAIN_CHECKOUT" ]; then
    run git -C "$ENV_MAIN_CHECKOUT" worktree repair --relative-paths "$ENV_PATH"

    # Copy (never link) the ignored local files a worktree needs, from the
    # same list other worktree tools use
    if [ -f "$ENV_MAIN_CHECKOUT/.worktreeinclude" ]; then
      while IFS= read -r entry || [ -n "$entry" ]; do
        case "$entry" in "" | "#"*) continue ;; esac
        [ -e "$ENV_MAIN_CHECKOUT/$entry" ] || continue
        [ -e "$ENV_PATH/$entry" ] && continue
        git -C "$ENV_MAIN_CHECKOUT" check-ignore -q -- "$entry" || continue
        log "Copying $entry from the main checkout"
        run mkdir -p "$(dirname "$ENV_PATH/$entry")"
        run cp -pR "$ENV_MAIN_CHECKOUT/$entry" "$ENV_PATH/$entry"
      done < "$ENV_MAIN_CHECKOUT/.worktreeinclude"
    fi
  fi

  if $trust; then
    env_trust_mise
  fi

  log "Writing $ENV_DOTENV"
  env_write_dotenv
  env_write_host_feature

  log "Building and starting the devcontainer"
  devcontainer_cli up --workspace-folder "$ENV_PATH" ${up_args[@]+"${up_args[@]}"}

  log "Waiting for health checks"
  deadline=$((SECONDS + 300))
  while :; do
    health="$(env_health "$ENV_NAME")"
    if [ -n "$health" ] && ! grep -qvE ' (healthy|running)$' <<<"$health"; then
      break
    fi
    [ "$SECONDS" -lt "$deadline" ] || die "services not healthy after 5 minutes:"$'\n'"$health"
    sleep 2
  done
  sed 's/^/    /' <<<"$health" >&2

  if [ "${#UP_COMMAND[@]}" -gt 0 ]; then
    log "Running UP_COMMAND from env.conf"
    (cd "$ENV_PATH" && cmd_exec "${UP_COMMAND[@]}")
  fi

  cmd_status
}

cmd_exec() {
  local cwd dir remote_env=()
  [ "$#" -gt 0 ] || die "usage: bin/de exec <command> [arguments]"
  env_running "$ENV_NAME" || die "environment $ENV_NAME isn't running, start it with bin/de up"

  cwd="$(pwd -P)"
  case "$cwd/" in
    "$ENV_PATH/"*) dir="$ENV_PATH_IN_CONTAINER${cwd#"$ENV_PATH"}" ;;
    *) dir="$ENV_PATH_IN_CONTAINER" ;;
  esac

  if [ -n "$ENV_SELENIUM_URL_GIVEN" ]; then
    log "Using Selenium at $ENV_SELENIUM_URL_GIVEN"
    remote_env+=(--remote-env "SELENIUM_URL=$ENV_SELENIUM_URL_GIVEN")
    remote_env+=(--remote-env "CAPYBARA_APP_HOST=$(env_capybara_app_host "$ENV_SELENIUM_URL_GIVEN")")
  fi
  if [ -n "${HEADLESS:-}" ]; then
    remote_env+=(--remote-env "HEADLESS=$HEADLESS")
  fi

  # mise on PATH too: its RubyGems plugin runs `mise reshim` after a gem
  # install, and without it Bundler crashes (and prints its config).
  devcontainer_cli exec --workspace-folder "$ENV_PATH" ${remote_env[@]+"${remote_env[@]}"} \
    bash -c 'cd "$1" && shift && PATH="$HOME/.local/bin:$PATH" exec mise exec -- "$@"' de-exec "$dir" "$@"
}

cmd_status() {
  local ids id service port
  [ "$#" -eq 0 ] || die "usage: bin/de status"

  cat <<EOF
Environment  $ENV_NAME
Kind         $ENV_KIND
Branch       ${ENV_BRANCH:-(detached)}
Checkout     $ENV_PATH
In container $ENV_WORKSPACE_LINK

EOF

  log "Containers"
  run docker container ls -a --filter "label=dev.env.name=$ENV_NAME" \
    --format 'table {{.Label "com.docker.compose.service"}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}'

  ids="$(docker container ls -q --filter "label=dev.env.name=$ENV_NAME")"
  if [ -n "$ids" ]; then
    echo
    log "Reachable from the Mac (OrbStack domains)"
    for id in $ids; do
      service="$(docker container inspect "$id" --format '{{ index .Config.Labels "com.docker.compose.service" }}')"
      for port in $(docker container inspect "$id" --format '{{ range $p, $_ := .Config.ExposedPorts }}{{ $p }} {{ end }}'); do
        printf '  %-10s %s.%s.orb.local:%s\n' "$service" "$service" "$ENV_NAME" "${port%/*}"
      done
      # Only when a host port was published, Docker picks the number
      docker port "$id" | sed "s/^/  $service published /"
    done
  fi

  echo
  log "Volumes"
  run docker volume ls --filter "label=com.docker.compose.project=$ENV_NAME"
  echo
  log "Networks"
  run docker network ls --filter "label=dev.env.name=$ENV_NAME"
}

# Runs `code` (CODE to override, e.g. CODE=cursor) with the dev container URI
# itself: vscli resolves ${localWorkspaceFolder} in devcontainer.json to
# /workspaces/<folder name> instead of the host path.
cmd_code() {
  local target="$ENV_PATH" name host_hex
  if [ "$#" -gt 1 ]; then
    die "usage: bin/de code [branch | environment | folder | path]"
  elif [ "$#" -eq 1 ]; then
    target="$(checkout_for "$1")"
    if [ -z "$target" ]; then
      warn "no checkout of $ENV_REPO matches $1, these exist:"
      checkouts_print
      die "create one with: bin/de new $1"
    fi
  fi

  [ -x "$target/bin/de" ] || die "$target has no bin/de, it predates the environment setup"

  name="$(env_name_for "$target")"
  if ! env_running "$name"; then
    log "Environment $name isn't running, starting it"
    if ! run "$target/bin/de" up; then
      # Still open it when only a setup step failed, the editor helps fix it
      env_running "$name" || die "bin/de up failed and $name isn't running"
      warn "bin/de up failed, see above, opening $name anyway"
    fi
  fi

  log "Opening $target ($name) in VS Code"
  # The authority is the host folder, hex encoded, the path is
  # devcontainer.json's workspaceFolder: /workspaces/<host path>
  host_hex="$(printf '%s' "$target" | xxd -p | tr -d '\n')"
  run "${CODE:-code}" --folder-uri "vscode-remote://dev-container+$host_hex/workspaces$target"
}

cmd_down() {
  local destroy_persistent=false arg answer
  for arg in "$@"; do
    case "$arg" in
      --destroy-persistent) destroy_persistent=true ;;
      *) die "usage: bin/de down [--destroy-persistent]" ;;
    esac
  done

  env_write_dotenv

  if [ "$ENV_KIND" = persistent ] || env_is_persistent "$ENV_NAME"; then
    if ! $destroy_persistent; then
      log "Stopping persistent environment $ENV_NAME, its volumes are kept"
      env_compose stop
      return
    fi

    [ -t 0 ] || die "--destroy-persistent needs a terminal to confirm"
    warn "This deletes $ENV_NAME and all of its data:"
    docker volume ls --filter "label=com.docker.compose.project=$ENV_NAME" >&2
    read -r -p "Type the environment name to confirm: " answer
    [ "$answer" = "$ENV_NAME" ] || die "name didn't match, nothing removed"
  else
    log "Removing ephemeral environment $ENV_NAME"
  fi

  env_compose down --volumes --remove-orphans
  env_destroy "$ENV_NAME"
  log "Removed $ENV_NAME"
}

cmd_prune() {
  local yes=false arg name path branch reason answer orphans=()
  for arg in "$@"; do
    case "$arg" in
      --yes | -y) yes=true ;;
      *) die "usage: bin/de prune [--yes]" ;;
    esac
  done

  log "Looking for ephemeral environments of $ENV_GIT_COMMON_DIR"
  for name in $(env_list ephemeral); do
    if env_is_persistent "$name"; then
      warn "$name has persistent resources, skipping"
      continue
    fi

    path="$(env_label "$name" dev.env.path)"
    branch="$(env_label "$name" dev.env.branch)"
    reason=""
    if [ -z "$path" ] || [ ! -d "$path" ]; then
      reason="checkout ${path:-?} no longer exists"
    elif ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
      reason="$path is no longer a git checkout"
    elif [ -n "$branch" ] && ! git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
      reason="branch $branch is gone"
    elif [ "$(env_name_for "$path")" != "$name" ]; then
      reason="$path is now on another branch"
    fi

    if [ -n "$reason" ]; then
      orphans+=("$name")
      printf '  %-50s %s\n' "$name" "$reason"
    else
      printf '  %-50s in use by %s, keeping\n' "$name" "$path"
    fi
  done

  if [ "${#orphans[@]}" -eq 0 ]; then
    log "Nothing to prune"
    return
  fi

  echo
  log "These resources will be removed:"
  for name in "${orphans[@]}"; do
    docker container ls -a --filter "label=com.docker.compose.project=$name" --format '  container {{.Names}}'
    docker volume ls --filter "label=com.docker.compose.project=$name" --format '  volume    {{.Name}}'
    docker network ls --filter "label=com.docker.compose.project=$name" --format '  network   {{.Name}}'
  done

  if ! $yes; then
    [ -t 0 ] || die "pass --yes to prune without a terminal"
    read -r -p "Remove ${#orphans[@]} environment(s)? [y/N] " answer
    [ "$answer" = y ] || [ "$answer" = Y ] || die "nothing removed"
  fi

  for name in "${orphans[@]}"; do
    log "Removing $name"
    env_destroy "$name"
  done
}

# --- Main ---------------------------------------------------------------

command="${1:-help}"
[ "$#" -gt 0 ] && shift

if [ -n "$DE_TEMPLATE" ]; then
  case "$command" in
    help | -h | --help) usage_source; exit ;;
    init | update) cmd_init "$@"; exit ;;
    upgrade) cmd_upgrade "$@"; exit ;;
  esac
  # `code <folder>` (Orca's "Open in" runs it from /) opens the checkout that
  # folder is in, from inside it, so a checkout's older bin/de handles it too
  if [ "$command" = code ] && [ "$#" -eq 1 ] && [ -d "$1" ]; then
    cd "$1"
    shift
  fi
  # Everything else is for the checkout the current directory is in
  checkout="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git checkout"
  [ -f "$checkout/.devcontainer/env.conf" ] && [ -x "$checkout/bin/de" ] ||
    die "$checkout has no development environments, set them up with: de init"
  exec "$checkout/bin/de" "$command" "$@"
fi

case "$command" in
  help | -h | --help) usage; exit ;;
  initialize | new | up | exec | status | code | down | prune) ;;
  init | update | upgrade) die "run de $command from the de repository, which bin/de comes from" ;;
  *) usage >&2; die "unknown command: $command" ;;
esac

env_init "$DE_ROOT"
"cmd_$command" "$@"
